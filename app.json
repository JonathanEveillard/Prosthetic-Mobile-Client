{
  "expo": {
    "name": "prosthetic_app",
    "slug": "prosthetic_app",
    "version": "1.0.0",
    "scheme": "prosthetic-app",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-router",
  [
    "react-native-ble-plx",
    {
      "isBackgroundEnabled": false,
      "modes": ["peripheral", "central"],
      "bluetoothAlwaysPermission": "Allow this app to connect to your ESP32 LED controller."
    }
  ]
    ]
  }
}
